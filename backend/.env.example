NODE_ENV=development
PORT=5000

# Structured logging (pino) — debug | info | warn | error
LOG_LEVEL=debug

# Error monitoring (optional — initialized only when set)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=rolebuddy-backend@1.0.0
MONGO_URI=mongodb://127.0.0.1:27017/rolebuddy
REDIS_URL=redis://127.0.0.1:6379
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE_MS=604800000

# API rate limiting (express-rate-limit on /api/*)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100


# ── Google Calendar OAuth (EXISTING — for interview scheduling) ──
# GOOGLE_OAUTH_REDIRECT_URI must match the backend callback route registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/interviews/calendar/callback

# ── Google Sign-In OAuth (NEW — for user authentication) ──
# Register a separate OAuth 2.0 Client ID in Google Cloud Console with redirect URI below.
# Authorized redirect URI to add in Google Cloud: http://localhost:5000/api/auth/google/callback
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ── Email — Resend (PRODUCTION — use this on Render, Vercel, Railway, etc.) ──
# Render blocks raw SMTP (port 587). Resend uses HTTPS so it always works.
# Sign up free at https://resend.com → API Keys → Create API Key
# Free tier: 3000 emails/month, 100/day
# RESEND_FROM_EMAIL must be a verified sender (your domain or resend's onboarding address)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="RoleBuddy <noreply@rolebuddy.me>"

# ── Email — Nodemailer SMTP (LOCAL DEV fallback only — ignored if RESEND_API_KEY is set) ──
# Gmail: enable 2FA → Google Account → Security → App Passwords → generate one
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="RoleBuddy <your@gmail.com>"
