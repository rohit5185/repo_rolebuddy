# Copy to .env before: docker compose up --build
# cp .env.example .env

# Required — use a long random string in real environments
JWT_SECRET=replace_with_long_random_secret

# Browser-facing URLs (host machine ports mapped by compose)
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Optional host port overrides
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=3000
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379

# API rate limiting (backend) — applied PER real client IP via Redis store.
# 500 req / 15 min = ~33 req/min per user (safe for normal usage + tab switching).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Auth-route rate limiting (login / signup / OTP) — stricter to block brute-force.
# 30 attempts / 15 min is generous for normal users.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Optional — backend also reads these when set
# MONGO_URI=mongodb://mongo:27017/rolebuddy
# REDIS_URL=redis://redis:6379

# Cookie Configuration (options: lax, strict, none for SameSite; true/false for Secure)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Internal API Base URL for server-side fetches inside Docker container (e.g. Next.js middleware / SSR)
INTERNAL_API_BASE_URL=http://backend:5000/api

# Google OAuth, email, VAPID — copy from backend/.env.example when needed
